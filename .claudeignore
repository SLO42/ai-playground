# Exclude large/irrelevant directories from Claude Code context

# This reduces input tokens for spawned agents significantly

# Playground runtime data (agents don't need chat history, reports, or logs)

.playground/chats/
.playground/reports/
.playground/headless-logs/
.playground/routing-log.json
.playground/agent-usage.json
.playground/agent-analytics.json
.playground/notifications.json

# Claude Flow runtime (agents use MCP tools instead of reading raw data)

.claude-flow/
.swarm/

# Build artifacts

dashboard/.svelte-kit/
dashboard/build/
dist/
build/

# Dependencies (never need to read these)

node_modules/
dashboard/node_modules/

# Agent definitions, skills, commands, and helpers (agents don't need these)

.claude/agents/
.claude/skills/
.claude/commands/
.claude/helpers/
.claude/memory.db

# Config files agents rarely need

config/security/certs/
config/openclaw/workspace/
config/openclaw/channels/
config/openclaw/models.json5
config/security/network-policy.yaml

# Task store files (heartbeat manages these, agents shouldn't browse)

.playground/tasks/
.playground/art/

# E2E test fixtures (agents writing unit tests don't need these)

dashboard/e2e/

# GitHub workflows (agents don't modify CI)

.github/

# OpenClaw local config

.openclaw/

# Scripts directory

scripts/

# Claude Flow data inside dashboard (session events, intelligence snapshots)

dashboard/.claude-flow/

# Docs and design assets (5.2MB — agents don't need reference docs or PNGs)

docs/

# Git internals

.git/

# Lock files

package-lock.json
dashboard/package-lock.json
