# ai-playground v2 — environment template. Copy to .env (gitignored).
# No secrets in committed files (CLAUDE.md / D-025 / D-026).

# Root under which projects are scanned/managed (loopback-only operator machine).
CODE_ROOT=F:/code

# SurrealDB (provisioned server binary on loopback — D-006/D-007).
SURREAL_WS=ws://127.0.0.1:8000
SURREAL_NS=playground
SURREAL_DB=v2
SURREAL_USER=
SURREAL_PASS=

# Ollama (local model + embeddings — D-003/D-014). NO /v1 suffix.
OLLAMA_HOST=http://127.0.0.1:11434

# Per-boot control-plane token (D-025). Generated at boot, never committed.
CONTROL_TOKEN=
