# v2-main is a docs-only orphan branch.
# The v1 working tree (dashboard/, CLAUDE.md, .env, node_modules/, etc.) is
# present on disk but is NOT part of this branch. Ignore everything at the
# repo root except docs/ and this file, so an accidental `git add -A` can
# never commit secrets (.env) or the v1 codebase onto v2-main.
/*
!/docs/
!/.gitignore

# Lastik font is license-restricted (That That Type Commercial, DECISIONS D-034):
# font binaries MUST NOT be committed to this public repo, even under docs/.
# Re-exclude them everywhere (a later rule overrides the !/docs/ inclusion above).
*.woff
*.woff2
*.ttf
*.otf
