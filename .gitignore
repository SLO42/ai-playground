# ai-playground v2 — build branch. Track source + docs + config; ignore the rest.

# Dependencies / build output
node_modules/
**/node_modules/
.svelte-kit/
**/.svelte-kit/
build/
dist/
*.tsbuildinfo

# Secrets & runtime data (D-025/D-026)
.env
.env.*
!.env.example
/.data/
**/.data/
*.log

# Per-session isolated Claude Code config dirs (S1/D-002) — runtime artifacts, never tracked
/.harness/
**/.harness/

# SurrealDB server binary + cache (D-006: provisioned at build, NOT committed)
/bin/surreal*
/.surreal/
/.cache/

# Lastik font is license-restricted (That That Type Commercial, D-034):
# font binaries MUST NOT be committed to this public repo. Provisioned at build.
*.woff
*.woff2
*.ttf
*.otf

# Playwright e2e output
/test-results/
/playwright-report/
/.playwright/

# Throwaway spike artifacts
/spikes/**/node_modules/
/spikes/.data/
/spikes/*.tmp

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
