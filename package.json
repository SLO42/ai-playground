{
  "name": "atelier",
  "version": "0.0.1",
  "private": true,
  "description": "Atelier — a local-first project lifecycle platform and Claude Code harness: create, develop, maintain, and release projects across their whole lifecycle.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "db:up": "vite-node -c vite.node.config.mts scripts/db-up.ts",
    "db:migrate": "vite-node -c vite.node.config.mts scripts/db-up.ts",
    "db:import": "vite-node -c vite.node.config.mts scripts/import-v1.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "vite build && vitest run && playwright test",
    "verify:browser": "node scripts/browser-verify/cli.mjs",
    "verify:flows": "node tests/verify-flows/lib/runner.mjs",
    "lint": "eslint .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "js-yaml": "^4.2.0",
    "json5": "^2.2.3",
    "motion": "^11.18.2",
    "surrealdb": "2.0.3"
  }
}
